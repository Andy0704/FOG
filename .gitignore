# ---- Secrets (NEVER commit) ----
.env
.env.*
*.pem
*.key
*.token
secrets.*
credentials*
# (GitHub PATs, API keys, etc. — keep these out of the repo and out of git history)

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual environments (do NOT commit; reproduce via requirements.txt) ----
fog_env_64/
fog_env/
fog_env_wsl/
.venv/
venv/
env/

# ---- Data: large + licensing. Document the download in data/README instead. ----
data/
# Keep a tracked pointer so the folder/instructions stay in the repo:
!data/README
!data/README.md

# ---- Results: reproducible artifacts; weights/large dumps are not tracked ----
results/_legacy/
results/**/models/
results/_tmp_checkpoints/
results/optuna/
*.pth
*.onnx
*.engine
*.plan
results/**/loso_detailed_predictions_*.csv
# (loss/roc PNGs and loso_summary_*.csv are small — keep them if you want figures
#  tracked; otherwise add: results/**/curves/ and results/**/*.csv)

# ---- Edge / deployment build artifacts ----
edge/**/*.onnx
edge/**/*.engine
edge/**/*.plan
edge/build/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# reports/: track txt summaries + case-study figures + references; ignore raw run logs
# (no broader "results/" rule exists above, so no negation is needed to un-ignore
# results/reports/ -- .txt/.png/.md there are tracked by default already; these two
# lines only add the raw-log ignore rules, policy choice B)
results/reports/06_run_logs/*.log
results/reports/*.log
